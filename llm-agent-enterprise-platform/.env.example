# Master credentials for all 6 database engines & LLM APIs

ENVIRONMENT=development
PROJECT_NAME=llm-agent-enterprise-platform
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 1. PostgreSQL (Relational Engine)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=llm_enterprise_db
POSTGRES_URI=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/llm_enterprise_db

# 2. Qdrant (Vector Engine)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=user_knowledge_base
VECTOR_SIZE=1536
VECTOR_DISTANCE=Cosine

# 3. Redis (Cache, Sessions & Message Broker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URI=redis://redis:6379/0

# 4. MongoDB (NoSQL Trace & Tool Document Store)
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_secure_password
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=llm_traces_db
MONGO_URI=mongodb://mongo_admin:mongo_secure_password@mongodb:27017/llm_traces_db?authSource=admin

# 5. MinIO (S3-Compatible Object Store)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_USE_SSL=False
MINIO_BUCKET_UPLOADS=user-uploads
MINIO_BUCKET_EXPORTS=exports

# 6. ClickHouse (Time-Series Telemetry & Analytics)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secure_password
CLICKHOUSE_DB=telemetry_db

# LLM Providers API Keys
OPENAI_API_KEY=sk-proj-example-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=sk-ant-example-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# External Tools & Sandbox
TAVILY_API_KEY=tvly-example-key
SANDBOX_URL=http://sandbox:8080
